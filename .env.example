# ✨ Story Time — Environment Variables
# ----------------------------------------
# HOW TO USE THIS FILE:
#   1. Copy this file: run `cp .env.example .env` in your terminal
#   2. Fill in YOUR values below (the ones marked REQUIRED)
#   3. If deploying to Netlify: add these same variables in
#      Netlify Dashboard → Site Configuration → Environment Variables
#      (you don't need a .env file on Netlify — just paste the values there)
#
# Your .env file is gitignored — it will NEVER be committed to GitHub.
# ----------------------------------------


# ============================================================
# REQUIRED — the app won't work without these
# ============================================================

# Your Claude API key
# Get one at: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model (optional — default shown)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Your ElevenLabs API key
# Get one at: https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=sk_your-key-here

# Your ElevenLabs Voice ID
# Either clone your own voice (Voices → Add Voice → Instant Voice Clone)
# or use a built-in voice ID from the ElevenLabs voice library
# e.g. "Matilda" (warm storytelling voice): XrExE9yKIg1WjnnlVkGX
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX

# ElevenLabs model (optional — default shown)
ELEVENLABS_MODEL=eleven_v3

# The password your family uses to access the app
# Pick anything memorable — everyone shares this one password
FAMILY_PASSWORD=sunshine42


# ============================================================
# KIDS CONFIG — make the stories personal
# ============================================================

# The children who appear as characters in every story
# Format: Name:Age,Name:Age,Name:Age  (no spaces around colons or commas)
# Example with 3 kids: KIDS=Sofia:7,James:4,Mia:1
# Example with 1 kid:  KIDS=Oscar:5
# Example with 2 kids: KIDS=Lily:6,Noah:3
KIDS=Sofia:7,James:4,Mia:1

# An adult character who appears in stories (aunty, grandma, dad, etc.)
# Example: Aunty Sarah, Grandma Rose, Uncle Ben
AUNTY_NAME=Aunty


# ============================================================
# STORY SETTINGS — optional tweaks
# ============================================================

# How many stories each device can generate per day (resets at midnight)
# Tip: keep this low (2-3) to manage ElevenLabs usage on the free tier
STORIES_PER_DAY=3

# Extra instructions added to every story (optional, can leave blank)
# Examples:
#   "Always start with Once upon a time."
#   "Always end with a lesson about kindness."
#   "Keep stories under 6 pages."
STORY_PROMPT_EXTRAS=Always start with Once upon a time.
